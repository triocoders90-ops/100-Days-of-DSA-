2. #SUM OF N NATURAL NUMBERS USING RECURSION

def natural_sum(num):
    if num == 0:
        return 0  # Base case: sum of 0 is 0

    return num + natural_sum(num - 1)
    # Recursive call: add current number with sum of remaining numbers

number = int(input("Enter the Value :"))
print(natural_sum(number))

==========================================

3. #FIBONACCI NUMBER USING RECURSION

def fibonacci(num):
    if num == 0:
        return 0  # Base case for the first Fibonacci number

    if num == 1:
        return 1  # Base case for the second Fibonacci number

    return fibonacci(num - 1) + fibonacci(num - 2)
    # Recursive calls continue until the base cases are reached

number = int(input("Enter the Position :"))
print(fibonacci(number))

==========================================

4. #POWER OF A NUMBER USING RECURSION

def power_of_number(base, exponent):
    if exponent == 0:
        return 1  # Base case: any number raised to 0 is 1

    return base * power_of_number(base, exponent - 1)
    # Recursive call: decrease exponent by 1

base = int(input("Enter the Base :"))
exponent = int(input("Enter the Exponent :"))

print(power_of_number(base, exponent))

