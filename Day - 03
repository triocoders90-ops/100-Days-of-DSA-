#DSA PHASE 1

1. #CHECK POWER OF A NUMBER

def pow_of_num(num,power):
    if power == 0:
        return 1
    return num * pow_of_num(num,power-1)

num = int(input("Enter the number :"))
power = int(input("Enter the power:"))
print(pow_of_num(num,power))

========================================

2. #COUNT DIGITS FROM A NUMBER

def count_of_num(n):
    n = abs(n)
    if n < 10:
        return 1
    return 1 + count_of_num(n // 10)

num = int(input("Enter the Value :"))
print(count_of_num(num))

========================================

3. #TOWERS OF HANOI

def tower_of_hanoi(n,s,a,d):
    if n == 1:
        print("Move disk 1 from",s,"to",d)
        return
        # Stop this recursive call and go back to the previous call

    tower_of_hanoi(n-1,s,d,a)
    print("Move disk",n,"from",s,"to",d)
    tower_of_hanoi(n-1,a,s,d)

n = int(input("Enter the Number of Disks :"))
tower_of_hanoi(n,"A","B","C")


Complexities
===================================================
Power of a Number: Time — O(power) | Space — O(power)
Count Digits: Time — O(log₁₀ n) | Space — O(log₁₀ n)
Tower of Hanoi: Time — O(2ⁿ) | Space — O(n)
