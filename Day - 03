1. #FACTORIAL OF A NUMBER

def factorial(num):
    if num == 0 or num == 1:
        return 1  # Base case: factorial of 0 or 1 is 1
    return num * factorial(num - 1) 
    # Recursive call: reduce the problem by 1

number = int(input("Enter the Value :"))
print(factorial(number))

