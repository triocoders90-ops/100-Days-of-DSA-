3. #CHECK GCD OF TWO NUMBERS 
def gcd_of_two(a,b):
    while a!=b:
        if a > b:
            a = a-b
        else:
            b = b-a
    return a # the loop will continue till the a value is equal to b value so the a value is returned

a = int(input("Enter the First Value :"))
b = int(input("Enter the Second Value : "))
print(gcd_of_two(a,b))
