## Day 1

### 1. Positive / Negative / Zero

```python
1. # Positive / Negative

def check_number(num):
    if num == 0:
        return "Zero"
    elif num > 0:
        return "Positive"
    else:
        return "Negative"

num = int(input("Enter a number: "))
print(check_number(num))
-----------------------------------
-----------------------------------
2. # Even / Odd

def check_even_odd(num):
    if num % 2 == 0:
        return "Even"
    else:
        return "Odd"

num = int(input("Enter a number: "))
print(check_even_odd(num))
